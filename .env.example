# انسخه إلى .env واملأ القيم. ممنوع تحط قيم حقيقية بهالملف.
# محلياً: كل شي له قيمة افتراضية للتجربة فقط، فـ `docker compose up` بيشتغل بدون ملف .env.
# على السيرفر (docker-compose.prod.yml): (بالنسخة الجاهزة كوليفاي بيولّد كلمات السر لحاله).

# قاعدة البيانات
POSTGRES_PASSWORD=

# تخزين الملفات (ميني أيو)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# الخطوات الجاية (غير مستخدمة بعد):
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# TOKEN_ENCRYPTION_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LOCAL_LLM_ENDPOINT=
